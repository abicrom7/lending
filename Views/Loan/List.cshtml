@model List<Lending.Models.ViewModel.LoanViewModel>

<h2 class="mt-5">Manage Loans</h2>
<div class="mt-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Loan Ref#</th>
                <th>Borrower</th>
                <th>Loan Amount</th>
                <th>Interest(%)</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.LoanReferenceNumber</td>
                        <td>@loan.BorrowerName</td>
                        <td>@loan.PrincipalAmount.ToString("C", new System.Globalization.CultureInfo("en-PH"))</td>
                        <td>@loan.InterestPercentage</td>
                        <td>@loan.TotalAmount.ToString("C", new System.Globalization.CultureInfo("en-PH"))</td>
                        <td>@loan.LoanStatus</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@loan.Id" class="btn btn-sm btn-primary">View</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No records of loans found.</td>
                </tr>
            }
          
        </tbody>
    </table>
    <div class="mt-3">
        <a asp-action="Add" class="btn btn-primary">New Loan</a>
    </div>
</div>  