@model Lending.Models.ViewModel.LoanViewModel
@using System.Text.Json

@{
    var isEditMode = Model.Id > 0;
    // var initialLoanDataJson = JsonSerializer.Serialize(Model);
    var initialLoanDataJson = JsonSerializer.Serialize(Model, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}
<h2 class="mt-5">Edit Loan</h2>
<div id="loan-form" class="mt-3">
    <form class="form-horizontal">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="loanReferenceNumber" class="form-label">Loan Reference Number</label>
                <input type="text"
                       id="loanReferenceNumber"
                       v-model="loan.loanReferenceNumber"
                       class="form-control form-control-sm" />
            </div>

            <div class="col-md-6">
                <label for="principalAmount" class="form-label">Principal Amount</label>
                <input type="text"
                       id="principalAmount"
                       v-model="loan.principalAmount"
                       class="form-control form-control-sm" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Borrower</label>
                <select v-model="loan.borrowerId" class="form-select form-select-sm">
                    <option disabled value="">Select a Borrower</option>
                    <option v-for="b in borrowers" :key="b.id" :value="b.id">
                        {{ b.name }}
                    </option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Interest(%)</label>
                <select v-model="loan.interestId" class="form-select form-select-sm">
                    <option disabled value="">Select Interest</option>
                    <option v-for="i in interests" :key="i.id" :value="i.id">
                        {{ i.interest }}
                    </option>
                </select>
            </div>

            <div class="col-md-6">
                <label for="coMaker" class="form-label">Co-Maker</label>
                <input type="text"
                       id="coMaker"
                       v-model="loan.comaker"
                       class="form-control form-control-sm" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Term(Months)</label>
                <select v-model="loan.loanPlan" class="form-select form-select-sm">
                    <option disabled value="">Select Term</option>
                    <option v-for="t in terms" :key="t.id" :value="t.id">
                        {{ t.months }}
                    </option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Collector</label>
                <select v-model="loan.collectorId" class="form-select form-select-sm">
                    <option disabled value="">Select a Collector</option>
                    <option v-for="c in collectors" :key="c.id" :value="c.id">
                        {{ c.name }}
                    </option>
                </select>
            </div>

            <div class="col-md-6">
                <label for="totalAmount" class="form-label">Total Amount</label>
                <input type="text"
                       id="totalAmount"
                       v-model="loan.totalAmount"
                       readonly
                       class="form-control form-control-sm" />
            </div>


            <div class="col-md-6">
                <label for="effectiveDate" class="form-label">Effective Date</label>
                <input type="text" id="effectiveDate" v-model="loan.effectiveDate" class="form-control form-control-sm flatpickr" autocomplete="off" />
            </div>

            <div class="col-md-6">
                <label for="monthlyPay" class="form-label">Monthly Pay</label>
                <input type="text"
                       id="monthlyPay"
                       v-model="loan.monthlyPay"
                       readonly
                       class="form-control form-control-sm" />
            </div>
            <div class="col-md-6">
                <label for="remarks" class="form-label">Remarks</label>
                <textarea id="remarks"
                          v-model="loan.remarks"
                          class="form-control form-control-sm"
                          rows="4"></textarea>
            </div>
        </div>
        <div class="mt-3">
            <div class="form-group">
                <button type="button" class="btn btn-primary" v-on:click="submitForm">Save</button>
                <a class="btn btn-secondary" asp-action="List" asp-controller="Loan">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Flatpickr CSS -->
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>



<script>
    var isEditMode = @isEditMode.ToString().ToLower();
    var initialLoanData = @(Html.Raw(initialLoanDataJson));

    new Vue({
        el: '#loan-form',
         data() {
        return {
            loan: isEditMode
                ? Object.assign({}, initialLoanData) // make a fresh reactive object
                : {
                    id:0,
                    loanReferenceNumber: '',
                    borrowerId: '',
                    collectorId: '',
                    interestId: '',
                    comaker: '',
                    loanPlan: '',
                    effectiveDate: '',
                    monthlyPay: '',
                    principalAmount: '',
                    totalAmount: '',
                    loanStatus: 'Pending',
                    remarks: ''
                },
            borrowers: [],
            collectors: [],
            interests: [],
            terms: []
        };
    },
        mounted() {
                 this.loadDropdownData();
                 if (isEditMode && this.loan.effectiveDate) {
                    this.loan.effectiveDate = this.loan.effectiveDate.split('T')[0];
                }
        },
        watch: {
            'loan.principalAmount': function () {
                this.compute();
            },
            'loan.interestId': function () {
                this.compute();
            },
            'loan.loanPlan': function () {
                this.compute();
            }
         },
        methods: {
            loadDropdownData() {
            const borrowersRequest = axios.get('/api/loan/borrowers');
            const collectorsRequest = axios.get('/api/loan/collectors');
            const interestsRequest = axios.get('/api/loan/interests');
            const termsRequest = axios.get('/api/loan/terms');

            Promise.all([borrowersRequest, collectorsRequest, interestsRequest, termsRequest])
                .then(([borrowersRes, collectorsRes, interestsRes, termsRes]) => {
                    this.borrowers = borrowersRes.data;
                    this.collectors = collectorsRes.data;
                    this.interests = interestsRes.data;
                    this.terms = termsRes.data;

                    // ✅ Safe to compute after dropdowns are loaded
                    if (isEditMode) {
                        this.compute();
                    }
                })
                .catch(err => {
                    console.error('Failed to load dropdown data:', err);
                });
            },
            compute() {
            const selectedInterest = this.interests.find(i => i.id === this.loan.interestId);
            const selectedTerm = this.terms.find(t => t.id === this.loan.loanPlan);

            if (!selectedInterest || !selectedTerm) {
                this.loan.totalAmount = '';
                this.loan.monthlyPay = '';
                return;
            }

            const interestRate = selectedInterest.interest / 100;
            const principal = parseFloat(this.loan.principalAmount) || 0;
            const totalAmount = principal * (1 + interestRate);
            const months = selectedTerm.months;

            this.loan.totalAmount = totalAmount.toFixed(2);
            this.loan.monthlyPay = (totalAmount / months).toFixed(2);
            },
            submitForm() {
                console.log('This.load',this.loan);
                axios.post('/api/loan/loans', this.loan)
                    .then(res => {
                         window.location.href = '/Loan/List';
                    })
                    .catch(err => {
                        console.error('Submit failed:', err);
                        alert('Something went wrong!');
                    });
            }
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        flatpickr(".flatpickr", {
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "F j, Y", // Ex: January 1, 2025
        });
    });
</script>