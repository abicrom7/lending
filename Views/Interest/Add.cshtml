@model Lending.Models.Interest


<h2 class="mt-5">Add Interest</h2>
<div class="mt-3">
    <form asp-action="Add" method="post" class="form-horizontal">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="InterestPercentage" class="form-label">Interest(%)</label>
                <input type="text" asp-for="InterestPercentage" class="form-control form-control-sm" />
            </div>
        </div>
        <div class="mt-3">
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-secondary" asp-action="List" asp-controller="Interest">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>

