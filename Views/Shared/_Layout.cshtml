<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lending</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lending.styles.css" asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body class="d-flex flex-column min-vh-100">

    <div class="d-flex flex-grow-1 w-100">
       
        <!-- Sidebar -->
        <nav class="bg-primary sidebar p-3 text-white" style="width: 220px;">
            <div class="sidebar-sticky">
                <img src="~/images/abicrom1.png" alt="Logo" class="img-fluid mb-2" style="max-width: 120px;" />
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white" asp-controller="Borrower" asp-action="List">Borrowers</a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white" asp-controller="Loan" asp-action="List">Loans</a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white" asp-controller="Report" asp-action="Index">Reports</a>
                    </li>

                    <!-- Collapsible Settings Menu -->
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#settingsSubmenu"
                           role="button"
                           aria-expanded="false"
                           aria-controls="settingsSubmenu">
                            Settings <span>&#9662;</span> <!-- ▼ arrow icon -->
                        </a>
                        <div class="collapse" id="settingsSubmenu">
                            <ul class="nav flex-column submenu-indent">
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Collector" asp-action="List">Collectors</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Interest" asp-action="List">Interests</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Term" asp-action="List">Terms</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="User" asp-action="List">Users</a>
                                </li>
                            </ul>
                        </div>
                    </li>


                    <li class="nav-item mt-4">
                        <a class="btn btn-light w-100" asp-controller="Borrower" asp-action="Add">+ New Borrower</a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Top Navbar aligned with main content -->
        <header class="bg-light border-bottom position-fixed" style="left: 220px; right: 0; height: 56px; z-index: 1030;">
            <div class="position-relative h-100">

                <!-- Centered Title -->
                <div class="position-absolute top-50 start-50 translate-middle">
                    <span class="fw-bold">Lending Management System ver 1.0.0</span>
                </div>

                <!-- Logout on Right -->
                <div class="d-flex justify-content-end align-items-center h-100 pe-4">
                    <form method="post" asp-controller="Account" asp-action="Logout" class="mb-0">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                    </form>
                </div>

            </div>
        </header>
        <!-- Main content -->
        <div class="flex-grow-1 main-wrapper p-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer aligned to content area -->
    <footer class="border-top bg-light text-muted text-center position-fixed bottom-0"
            style="left: 220px; right: 0; height: 50px; z-index: 1030;">
        <div class="d-flex justify-content-center align-items-center h-100">
            &copy; 2025 - Abicrom Technologies | Lending Management System v1.0.0
            <a class="ms-1" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>


</html>
