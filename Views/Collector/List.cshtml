@model List<Lending.Models.Collector>

<h2 class="mt-5">Manage Collectors</h2>
<div class="mt-3">
    @if (Model != null)
    {
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Date of Birth</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
    @if (Model.Any())
    {
            @foreach (var collector in Model)
            {
                <tr>
                    <td>@collector.Name</td>
                    <td>@collector.Email</td>
                    <td>@collector.PhoneNumber</td>
                    <td>@collector.DateOfBirth?.ToString("MM/dd/yyyy")</td>
                    <td>@collector.Address</td>
                    <td>
                        <a asp-controller="Collector" asp-action="Edit" asp-route-id="@collector.Id" class="btn btn-secondary">View</a>
                    </td>
                </tr>
              }
    }
    else
            {
                <tr>
                    <td colspan="6" class="text-center">No collectors found.</td>
                </tr>
            }
                    </tbody>
    </table>
    }
    else
    {
        <p class="text-danger">Data is not available.</p>
    }   
    <div class="mt-3">
        <a asp-action="Add" class="btn btn-primary">Add Collector</a>
    </div>
</div>  