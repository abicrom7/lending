@model Lending.Models.Collector

<h2 class="mt-5">Edit Collector</h2>
@if (Model is null)
{
    <p>No collector found with this Id.</p>
}
else
{
    <div class="mt-3">
        <form asp-action="Edit" method="post" class="form-horizontal">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input type="text" asp-for="Name" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input type="email" asp-for="Email" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone</label>
                    <input type="text" asp-for="PhoneNumber" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input type="text" asp-for="DateOfBirth" class="form-control form-control-sm flatpickr" autocomplete="off" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="4"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <div class="form-group">
                    <a class="btn btn-secondary" asp-action="List" asp-controller="Collector">
                        Back to Collectors List
                    </a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>

        <form asp-action="Delete" asp-controller="Collector" method="post"
              onsubmit="return confirm('Are you sure you want to delete this collector?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger mt-2">Delete</button>
        </form>
    </div>
}

<!-- Flatpickr CSS -->
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">

<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        flatpickr(".flatpickr", {
            dateFormat: "Y-m-d", 
            altInput: true,
            altFormat: "F j, Y", // Ex: January 1, 2025
        });
    });
</script>
