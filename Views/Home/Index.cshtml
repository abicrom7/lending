@{
    ViewData["Title"] = "Welcome to Lending Management System";
}

<div class="hero bg-light text-center py-4 mt-5">
    <div class="container">
        <h2>Lending Management System</h2> <h4>version 1.0.0</h4>
        <p class="lead text-muted mt-3">
            Efficiently manage borrowers, loans, and payments — all in one place.
        </p>
        <a class="btn btn-primary btn-lg mt-4" asp-controller="Loan" asp-action="List">View Loans</a>
    </div>
</div>

<div class="features-section py-4 bg-white">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Active Borrowers</h5>
                    <p class="text-muted">5</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Principal Released</h5>
                    <p class="text-muted">1</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Requested Loans</h5>
                    <p class="text-muted">10</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Fully Paid Loans</h5>
                    <p class="text-muted">0</p>
                </div>
            </div>
        </div>
        <div class="row text-center">
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Pending Loans</h5>
                    <p class="text-muted">5</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Rejected Loans</h5>
                    <p class="text-muted">1</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Overdue Loans</h5>
                    <p class="text-muted">10</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-4 border rounded">
                    <h5 class="fw-bold">Due Today Loans</h5>
                    <p class="text-muted">0</p>
                </div>
            </div>
        </div>
    </div>
</div>

