@model List<Lending.Models.Borrower>

<h2 class="mt-5">Manage Borrowers</h2>
<div class="mt-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Date of Birth</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var borrower in Model)
            {
                <tr>
                    <td>@borrower.Name</td>
                    <td>@borrower.Email</td>
                    <td>@borrower.PhoneNumber</td>
                    <td>@borrower.DateOfBirth?.ToString("MM/dd/yyyy")</td>
                    <td>@borrower.Address</td>
                    <td>
                        <a asp-controller="Borrower" asp-action="Edit" asp-route-id="@borrower.Id" class="btn btn-secondary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="mt-3">
        <a asp-action="Add" class="btn btn-primary">Add Borrower</a>
    </div>
</div>  