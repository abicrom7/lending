@model Lending.Models.Term

<h2 class="mt-5">Edit Term</h2>
@if (Model is null)
{
    <p>No term found with this Id.</p>
}
else
{
    <div class="mt-3">
        <form asp-action="Edit" method="post" class="form-horizontal">
            <div class="col-md-6">
                <label class="control-label">Id</label>
                <input type="text" class="form-control" asp-for="Id" readonly />
            </div>
            <div class="col-md-6">
                <label class="control-label">Months</label>
                <input type="text" class="form-control" asp-for="Months" />
            </div>

            <div class="mt-3">
                <div class="form-group">
                    <a class="btn btn-secondary" asp-action="List" asp-controller="Term">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>

        <form asp-action="Delete" asp-controller="Term" method="post"
              onsubmit="return confirm('Are you sure you want to delete this term?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger mt-2">Delete</button>
        </form>
    </div>
}

