@model List<Lending.Models.Term>

<h2 class="mt-5">Manage Terms</h2>
<div class="mt-3">
    @if (Model != null)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Months</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Months</td>
                            <td>
                                <a asp-controller="Term" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-secondary">View</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No terms found.</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-danger">Data is not available.</p>
    }

    <div class="mt-3">
        <a asp-action="Add" class="btn btn-primary">Add Term</a>
    </div>
</div>
